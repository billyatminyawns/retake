# Retake API environment.
#   Docker:  cp deploy/.env.example deploy/.env   (docker-compose reads it; .env is git-ignored)
#   Local:   set -a; source deploy/.env; set +a; ./run.sh
# Values are read server-side only. Keys are never sent to the browser and never logged.

# ─── Keys ────────────────────────────────────────────────────────────────────
# WellSaid: needed to render scripts (JSON POST /v1/jobs) and to fix flagged lines.
# On Billy's Mac the API falls back to ~/Downloads/wellsaid-connector/.env when unset.
WELLSAID_API_KEY=
# Anthropic: enables the Claude intent engine (decides which pronunciation the SCRIPT meant).
# Unset = spaCy part-of-speech fallback (fine on clear sentences, weaker on ambiguous ones).
ANTHROPIC_API_KEY=

# ─── Product auth ────────────────────────────────────────────────────────────
# Comma-separated list of accepted X-Api-Key values. Empty = OPEN (dev mode; /v1/health reports
# "auth":"open"). Generate one:  python3 -c "import secrets; print('rtk_' + secrets.token_urlsafe(24))"
RETAKE_API_KEYS=

# ─── Browser access ──────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser (comma list). "*" for dev; for the hosted UI:
# https://billyatminyawns.github.io
RETAKE_CORS_ORIGINS=*

# ─── Storage ─────────────────────────────────────────────────────────────────
# Job store: SQLite jobs.db + jobs/<id>/ (media, clips, takes, reports). Docker: the /data volume.
# Local default when unset: <project>/var
RETAKE_DATA=/data
# Model cache (wav2vec2 + faster-whisper). Docker: /models (baked into the image). Setting it also
# points HF_HOME at the same place so transformers, huggingface_hub and faster-whisper share one cache.
RETAKE_MODELS=/models
HF_HOME=/models

# ─── Engine knobs (optional) ─────────────────────────────────────────────────
# Whisper backend: faster (portable CPU default) | mlx (Apple-silicon Macs only, via /usr/bin/python3)
RETAKE_WHISPER=faster
# CPU threads for faster-whisper (0 = library default)
RETAKE_WHISPER_THREADS=0
# Intent engine when a request does not say: both | claude | spacy
RETAKE_INTENT_ENGINE=both
# Upload cap for POST /v1/jobs (MB) and script length cap for render mode (chars)
RETAKE_MAX_UPLOAD_MB=500
RETAKE_MAX_TEXT_CHARS=6000
RETAKE_LOG_LEVEL=INFO

# ─── Server ──────────────────────────────────────────────────────────────────
# Listening port. Image default 8080; Hugging Face Spaces expects 7860 (deploy/hf-space.sh sets it).
PORT=8080
